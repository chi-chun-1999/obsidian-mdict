function changeMdict() {
	if (!mdictSelected.value) {
		console.warn("No MDIC selected.");
		return;
	}

	mdictEngine = new MdictEngine(getMdxMddPaths(mdictSelected.value));

	if (searchWord.value) {
		definition();
	} else {
		mdictResult.value = '';
	}
